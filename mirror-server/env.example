# ── ПВ-Система, резервное зеркало: настройки ─────────────────────────────────
# Скопируйте в файл .env (cp env.example .env) и заполните.

# Своя база PostgreSQL на этом сервере (создаёт install.sh)
DATABASE_URL=postgresql://pvs:ПАРОЛЬ_БАЗЫ@127.0.0.1:5432/pvs
MAIN_DB_SCHEMA=public

# ТОТ ЖЕ пароль админ-панели, что и на poehali.dev (секрет ADMIN_PASSWORD)
ADMIN_PASSWORD=

# ТОТ ЖЕ приватный ключ подписи лицензий (секрет OFFLINE_KEY_PRIVATE).
# Обязательно точно такой же: публичная половина зашита в программу,
# с другим ключом выданные лицензии и аварийные ключи не пройдут проверку.
OFFLINE_KEY_PRIVATE=

# Адрес админ-функции в облаке — откуда синхронизировать лицензии,
# пока poehali.dev работает (sync_from_cloud.py)
CLOUD_ADMIN_URL=https://functions.poehali.dev/bd72524f-fb9c-4866-8bcd-69ced85263d4
CLOUD_VERSION_URL=https://functions.poehali.dev/0ddfea8a-386f-4cb2-9fe0-37274caf2e16

# Порт, на котором слушает приложение (nginx проксирует на него)
PVS_HOST=127.0.0.1
PVS_PORT=8900
