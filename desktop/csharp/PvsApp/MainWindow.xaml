<Window x:Class="PvsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ПВ-Система"
        Width="1400" Height="900"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#1f2328"
        ResizeMode="CanResize">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="5"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Фирменные цвета: антрацит + сигнальный янтарь + сине-стальной.
         Совпадают с заставкой веб-части (index.html) и интерфейсом. -->
    <SolidColorBrush x:Key="Anthracite" Color="#1f2328"/>
    <SolidColorBrush x:Key="Amber"      Color="#e8a317"/>

    <!-- Индикатор загрузки: бегущая янтарная полоса на тёмной дорожке,
         как на заставке веб-части. -->
    <Style x:Key="SplashBar" TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="1.5" Background="#14FFFFFF" ClipToBounds="True">
              <Border x:Name="Runner" Width="96" CornerRadius="1.5" HorizontalAlignment="Left">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00E8A317" Offset="0"/>
                    <GradientStop Color="#FFF5B83D" Offset="0.5"/>
                    <GradientStop Color="#00E8A317" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                  <TranslateTransform x:Name="RunnerMove" X="-96"/>
                </Border.RenderTransform>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="RunnerMove"
                                     Storyboard.TargetProperty="X"
                                     From="-96" To="240" Duration="0:0:1.4">
                      <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Фон окна = тонкая «рамка» вокруг WebView. WebView2 (дочерний HWND
       браузера) перекрывает окно и не пропускает события рамки ресайза к WPF.
       Поэтому оставляем по краям полоску шириной ResizeBorderThickness (6px),
       не занятую браузером — Windows получает по ней WM_NCHITTEST и позволяет
       тянуть края.
       Цвет рамки — антрацит (#1f2328), как шапка вкладок и строка состояния.
       Раньше рамка была светло-серой (#e0e0e0): вокруг тёмной заставки она
       читалась как серая каёмка, а в момент смены заставки на интерфейс окно
       на долю секунды заливалось серым. -->
  <Grid Background="{StaticResource Anthracite}">
    <!-- Splash / загрузка — тот же вид, что у заставки веб-части (index.html):
         антрацит, янтарное свечение, стальная глубина снизу, миллиметровка. -->
    <Grid x:Name="SplashGrid" Panel.ZIndex="10" Margin="6" ClipToBounds="True">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#2B2F33" Offset="0"/>
          <GradientStop Color="#1F2328" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>

      <!-- Миллиметровка: крупная клетка 100 px и мелкая 20 px -->
      <Rectangle IsHitTestVisible="False" Opacity="0.9">
        <Rectangle.Fill>
          <DrawingBrush TileMode="Tile" Viewport="0,0,100,100" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
              <DrawingGroup>
                <GeometryDrawing>
                  <GeometryDrawing.Pen><Pen Brush="#05FFFFFF" Thickness="1"/></GeometryDrawing.Pen>
                  <GeometryDrawing.Geometry>
                    <GeometryGroup>
                      <LineGeometry StartPoint="20,0" EndPoint="20,100"/>
                      <LineGeometry StartPoint="40,0" EndPoint="40,100"/>
                      <LineGeometry StartPoint="60,0" EndPoint="60,100"/>
                      <LineGeometry StartPoint="80,0" EndPoint="80,100"/>
                      <LineGeometry StartPoint="0,20" EndPoint="100,20"/>
                      <LineGeometry StartPoint="0,40" EndPoint="100,40"/>
                      <LineGeometry StartPoint="0,60" EndPoint="100,60"/>
                      <LineGeometry StartPoint="0,80" EndPoint="100,80"/>
                    </GeometryGroup>
                  </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                  <GeometryDrawing.Pen><Pen Brush="#0CFFFFFF" Thickness="1"/></GeometryDrawing.Pen>
                  <GeometryDrawing.Geometry>
                    <GeometryGroup>
                      <LineGeometry StartPoint="0,0" EndPoint="0,100"/>
                      <LineGeometry StartPoint="0,0" EndPoint="100,0"/>
                    </GeometryGroup>
                  </GeometryDrawing.Geometry>
                </GeometryDrawing>
              </DrawingGroup>
            </DrawingBrush.Drawing>
          </DrawingBrush>
        </Rectangle.Fill>
        <Rectangle.OpacityMask>
          <RadialGradientBrush RadiusX="0.7" RadiusY="0.65" Center="0.5,0.45" GradientOrigin="0.5,0.45">
            <GradientStop Color="#FF000000" Offset="0.2"/>
            <GradientStop Color="#00000000" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.OpacityMask>
      </Rectangle>

      <!-- Янтарное свечение за логотипом -->
      <Ellipse Width="760" Height="520" VerticalAlignment="Center" HorizontalAlignment="Center"
               Margin="0,-80,0,0" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#1AE8A317" Offset="0"/>
            <GradientStop Color="#00E8A317" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <!-- Сине-стальная глубина снизу -->
      <Ellipse Width="1600" Height="700" VerticalAlignment="Bottom" HorizontalAlignment="Center"
               Margin="0,0,0,-420" IsHitTestVisible="False">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#731E5A7A" Offset="0"/>
            <GradientStop Color="#001E5A7A" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <!-- Янтарная сигнальная полоса по верхнему краю -->
      <Border Height="3" VerticalAlignment="Top" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E8A317" Offset="0"/>
            <GradientStop Color="#FFE8A317" Offset="0.2"/>
            <GradientStop Color="#FFF5B83D" Offset="0.5"/>
            <GradientStop Color="#FFE8A317" Offset="0.8"/>
            <GradientStop Color="#00E8A317" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Логотип в тёмном скруглённом квадрате с янтарной каймой -->
        <Border Width="132" Height="132" CornerRadius="32"
                Background="#0AFFFFFF" BorderBrush="#40E8A317" BorderThickness="1.5"
                HorizontalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.55"/>
          </Border.Effect>
          <Image Source="pack://application:,,,/splash-logo.png" Width="92" Height="92"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <TextBlock HorizontalAlignment="Center" Margin="0,28,0,0"
                   FontFamily="Segoe UI" FontWeight="Bold" FontSize="34" Foreground="White">
          <Run Text="ПВ"/><Run Text="-" Foreground="{StaticResource Amber}"/><Run Text="Система"/>
        </TextBlock>
        <TextBlock Text="ПРОЕКТИРОВАНИЕ ВЕНТИЛЯЦИИ И ВОДОСНАБЖЕНИЯ"
                   HorizontalAlignment="Center" Margin="0,12,0,0"
                   FontFamily="Segoe UI" FontSize="12" Foreground="#9AA3AD"/>

        <ProgressBar x:Name="SplashProgress" Style="{StaticResource SplashBar}"
                     IsIndeterminate="True" Width="240" Height="3" Margin="0,34,0,0"/>

        <!-- Текст статуса меняет C# (SetStatus) — имя элемента сохранено -->
        <TextBlock Text="Запуск расчётного ядра..."
                   x:Name="SplashStatus"
                   HorizontalAlignment="Center" Margin="0,14,0,0"
                   FontFamily="Consolas" FontSize="12" Foreground="#7C848D"/>
      </StackPanel>

      <TextBlock Text="© 2026 ПВ-Система. Все права защищены."
                 VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                 FontFamily="Segoe UI" FontSize="11" Foreground="#6B737C"/>
    </Grid>

    <!-- WebView2. Margin=6 оставляет зону ресайза окну (см. комментарий выше).
         DefaultBackgroundColor — антрацит: пока страница не отрисовала первый
         кадр, браузер заливает окно этим цветом, а не белым. Без этого между
         исчезновением заставки и появлением веб-заставки мелькал белый/серый
         экран. -->
    <wv2:WebView2 x:Name="WebView"
                  Margin="6"
                  DefaultBackgroundColor="#1F2328"
                  Visibility="Collapsed"/>
  </Grid>
</Window>
